{
    "name": "juststeveking/pingback-sdk",
    "description": "The PHP SDK for Pingback, a small CRM API, built on sdk-toolbox. A demonstration, not a release.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "cuyz/valinor": "^2.6",
        "juststeveking/sdk-toolbox": "^0.0.4"
    },
    "require-dev": {
        "laravel/pint": "^1.25",
        "nyholm/psr7": "^1.8",
        "pestphp/pest": "^4.1",
        "phpstan/phpstan": "^2.1",
        "symfony/http-client": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "JustSteveKing\\Pingback\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JustSteveKing\\Pingback\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:contract": "pest --testsuite=Contract",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "lint": "pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": false
        }
    }
}
